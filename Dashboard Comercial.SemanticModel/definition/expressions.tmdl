expression similaridade_clientes =
		let
		    Fonte = Sql.Databases("localhost"),
		    Dataset = Fonte{[Name="PinskiDatabase"]}[Data],
		    View = Dataset{[Schema="dbo",Item="fVendas"]}[Data],
		    #"Changed Type" = Table.TransformColumnTypes(View,{{"vendedor_id", type text}, {"cliente_id", type text}, {"valor_desconto", type number}, {"valor_unitario", type number}, {"produto_id", type text}}),
		    #"Linhas Filtradas" = Table.SelectRows(#"Changed Type", each Date.IsInCurrentYear([data])),
		    #"Colunas Removidas" = Table.RemoveColumns(#"Linhas Filtradas",{"nfe", "valor_desconto", "valor_unitario", "vendedor_id", "data"}),
		    #"Colunas Renomeadas" = Table.RenameColumns(#"Colunas Removidas",{{"cliente_id", "cliente"}, {"produto_id", "produto"}}),
		    #"Linhas Agrupadas" = Table.Group(#"Colunas Renomeadas", {"cliente", "produto"}, {{"quantidade", each List.Sum([item_quantidade]), type nullable number}}),
		    #"Executar script Python" = Python.Execute("import pandas as pd#(lf)from sklearn.metrics.pairwise import cosine_similarity#(lf)#(lf)# 'dataset' contém os dados de entrada para este script.#(lf)#(lf)# Criando uma matriz de utilidade onde:#(lf)# - Linhas representam clientes#(lf)# - Colunas representam produtos#(lf)# - Valores representam a quantidade comprada#(lf)matriz_utilidade = dataset.pivot_table(index='cliente',#(lf)                                       values='quantidade',#(lf)                                       columns='produto',#(lf)                                       fill_value=0)#(lf)#(lf)# Calculando a similaridade cosseno entre os clientes com base em seus padrões de compra.#(lf)matriz_similaridade = cosine_similarity(matriz_utilidade)#(lf)#(lf)# Convertendo a matriz de similaridade em um DataFrame para fácil manipulação.#(lf)# Os índices e colunas são os nomes dos clientes.#(lf)df_similaridade = pd.DataFrame(matriz_similaridade, index=matriz_utilidade.index, columns=matriz_utilidade.index)#(lf)#(lf)# Definindo o número de clientes semelhantes a serem considerados e o número de recomendações de produtos a serem feitas.#(lf)k = 3#(lf)numero_recomendacoes = 3#(lf)recomendacoes = {}#(lf)#(lf)# Iterando sobre cada cliente para fazer recomendações.#(lf)for c in df_similaridade.index:#(lf)    # Encontrando os 'k' clientes mais semelhantes ao cliente atual.#(lf)    clientes_semelhantes = df_similaridade.loc[c].nlargest(k+1).iloc[1:].index#(lf)    #(lf)    # Somando as quantidades de produtos comprados por clientes semelhantes.#(lf)    comprados_por_semelhantes = matriz_utilidade.loc[clientes_semelhantes].sum(axis=0)#(lf)    #(lf)    # Identificando produtos que o cliente atual ainda não comprou.#(lf)    nao_comprados_pelo_atual = matriz_utilidade.loc[c] == 0#(lf)    #(lf)    # Recomendando os 'numero_recomendacoes' produtos mais comprados por clientes semelhantes que o cliente atual ainda não comprou.#(lf)    produtos_recomendados = comprados_por_semelhantes[nao_comprados_pelo_atual].nlargest(numero_recomendacoes).index.tolist()#(lf)    #(lf)    # Armazenando as recomendações para o cliente atual.#(lf)    recomendacoes[c] = produtos_recomendados#(lf)#(lf)# Convertendo o dicionário de recomendações em um DataFrame.#(lf)df_recomendacoes = pd.DataFrame(list(recomendacoes.items()), columns=['Cliente', 'Produtos Recomendados'])#(lf)#(lf)# Adicionando uma coluna 'cliente' ao DataFrame de similaridade para fácil referência.#(lf)df_similaridade['cliente'] = df_similaridade.index#(lf)#(lf)# Reordenando as colunas para que a coluna 'cliente' seja a primeira.#(lf)cols = ['cliente'] + [col for col in df_similaridade if col != 'cliente']#(lf)df_similaridade = df_similaridade[cols]",[dataset=#"Linhas Agrupadas"])
		in
		    #"Executar script Python"
