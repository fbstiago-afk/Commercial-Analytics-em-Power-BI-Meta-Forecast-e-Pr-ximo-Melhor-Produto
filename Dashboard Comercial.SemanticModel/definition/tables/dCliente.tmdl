	/// Data da primeira compra do cliente em todo o histórico.
	column 'Primeira Compra' = CALCULATE ( MIN ( fVendas[data] ) )
		dataType: dateTime
		formatString: dd/MM/yyyy
		displayFolder: RFV
		lineageTag: a3b9d1bb-2371-4311-896f-6e5623ccbddd
		summarizeBy: none

	/// Data da compra mais recente do cliente.
	column 'Última Compra' = CALCULATE ( MAX ( fVendas[data] ) )
		dataType: dateTime
		formatString: dd/MM/yyyy
		displayFolder: RFV
		lineageTag: ae860113-9496-42d6-863c-fb7b9cf5ff95
		summarizeBy: none

	/// Dias entre a última compra do cliente e a última venda da base.
	column 'Recência (dias)' =
			VAR vRef = MAX ( fVendas[data] )
			VAR vUltima = CALCULATE ( MAX ( fVendas[data] ) )
			RETURN
			    IF ( NOT ISBLANK ( vUltima ), DATEDIFF ( vUltima, vRef, DAY ) )
		dataType: int64
		formatString: #,0
		displayFolder: RFV
		lineageTag: 2a25067d-efa5-4bd6-99bb-8c7fc2cf267b
		summarizeBy: none

	/// Notas fiscais do cliente nos 12 meses até a última venda da base (frequência).
	column 'Pedidos 12M' =
			VAR vRef = MAX ( fVendas[data] )
			RETURN
			    CALCULATE ( DISTINCTCOUNT ( fVendas[nfe] ), fVendas[data] > EDATE ( vRef, -12 ) ) + 0
		dataType: int64
		formatString: #,0
		displayFolder: RFV
		lineageTag: c7191e28-4a8c-4ce6-9d03-71b97e23e083
		summarizeBy: sum

	/// Faturamento do cliente nos 12 meses até a última venda da base (valor).
	column 'Faturamento 12M' =
			VAR vRef = MAX ( fVendas[data] )
			RETURN
			    CALCULATE (
			        SUMX ( fVendas, fVendas[item_quantidade] * fVendas[valor_unitario] - fVendas[valor_desconto] ),
			        fVendas[data] > EDATE ( vRef, -12 )
			    ) + 0
		dataType: double
		formatString: \R$ #,0;-\R$ #,0
		displayFolder: RFV
		lineageTag: fa32e396-a8de-4921-b1d7-8bf030abaa49
		summarizeBy: sum

	/// Segmentação por regras (não é cluster estatístico), fotografada na data da última venda. Inativos: sem compra há mais de 365 dias. Em risco: 181 a 365 dias. Novos: primeira compra nos últimos 180 dias. VIP: 3+ notas em 12M e faturamento 12M no quartil superior. Leais: 2+ notas em 12M. Potencial: 1 nota em 12M. O ciclo médio de recompra da base é de ~6 meses, por isso os cortes de 180/365 dias.
	column 'Segmento RFV' =
			VAR vRef = MAX ( fVendas[data] )
			VAR vRecencia = dCliente[Recência (dias)]
			VAR vFreq = dCliente[Pedidos 12M]
			VAR vValor = dCliente[Faturamento 12M]
			VAR vCorteValor =
			    PERCENTILEX.INC ( FILTER ( dCliente, dCliente[Pedidos 12M] > 0 ), dCliente[Faturamento 12M], 0.75 )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( dCliente[Última Compra] ), BLANK (),
			        vRecencia > 365, "Inativos",
			        vRecencia > 180, "Em risco",
			        dCliente[Primeira Compra] > vRef - 180, "Novos",
			        vFreq >= 3 && vValor >= vCorteValor, "VIP",
			        vFreq >= 2, "Leais",
			        "Potencial"
			    )
		dataType: string
		displayFolder: RFV
		lineageTag: d79caab3-5072-4f1d-9b27-aa9201c116a8
		summarizeBy: none

	partition dCliente-6b2f8da8-fc27-4434-aa5b-50b675551748 = m
