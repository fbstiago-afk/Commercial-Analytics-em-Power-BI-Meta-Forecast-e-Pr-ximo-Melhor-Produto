			RETURN
			    IF ( NOT ISBLANK ( v ), IF ( v >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( v ), "0.0%" ) & IF ( v >= 0, " acima da meta", " abaixo da meta" ) )
		displayFolder: 09 UX\Rótulos
