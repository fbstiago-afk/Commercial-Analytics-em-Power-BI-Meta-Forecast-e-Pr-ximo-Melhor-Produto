table Medidas
	lineageTag: 7b9bf870-9005-415b-afbf-1731cdaf492f

	/// Lista textual dos clientes similares (versão revisada da medida original, mantida para leitores de tela e exportação).
	measure 'Texto Clientes Similares' =
			IF (
			    [Clientes Similares] > 0,
			    "Clientes com mix de compras mais parecido: "
			        & CONCATENATEX (
			            FILTER ( dClienteSimilar, NOT ISBLANK ( [Similaridade] ) ),
			            dClienteSimilar[descricao] & " (" & FORMAT ( [Similaridade], "0%" ) & ")",
			            ", ",
			            [Similaridade], DESC
			        ) & ".",
			    "Este cliente não possui similares."
			)
		displayFolder: 07 Recomendação\Similares
		lineageTag: a1168fbb-0dd2-4b2f-924b-ca84f889a482

	/// Receita líquida: quantidade × valor unitário − desconto. Mesma regra da medida original '$ Faturamento'.
	measure Faturamento =
			SUMX (
			    fVendas,
			    fVendas[item_quantidade] * fVendas[valor_unitario] - fVendas[valor_desconto]
			)
		displayFolder: 00 Base
		lineageTag: bd519b54-1900-4886-90ba-54b4b6f7fbf6

		formatStringDefinition =
				VAR v = ABS ( SELECTEDMEASURE () )
				RETURN
				    SWITCH (
				        TRUE (),
				        v >= 1E6, "\R$ #,0,,.00 \M\i;-\R$ #,0,,.00 \M\i",
				        v >= 1E4, "\R$ #,0,.0 \m\i\l;-\R$ #,0,.0 \m\i\l",
				        "\R$ #,0;-\R$ #,0"
				    )

	/// Itens vendidos (soma de item_quantidade).
	measure Quantidade = SUM ( fVendas[item_quantidade] )
		formatString: #,0
		displayFolder: 00 Base
		lineageTag: 298937a2-17a3-49d6-b5fc-64581be7c65d

	/// Notas fiscais distintas (NF-e). O modelo não possui pedido separado da nota.
	measure Pedidos = DISTINCTCOUNT ( fVendas[nfe] )
		formatString: #,0
		displayFolder: 00 Base
		lineageTag: 1483ebed-dc21-417b-aaa1-486a6f83ce8c

	/// Clientes distintos com compra no contexto.
	measure Clientes = DISTINCTCOUNT ( fVendas[cliente_id] )
		formatString: #,0
		displayFolder: 00 Base
		lineageTag: 07243d0e-64c6-4db4-822a-a10f81c1a762

	/// SKUs (produto + tamanho) distintos vendidos.
	measure 'SKUs Vendidos' = DISTINCTCOUNT ( fVendas[produto_id] )
		formatString: #,0
		displayFolder: 00 Base
		lineageTag: 0667fac9-c9eb-44c8-9e99-10ae4c17acba

	/// Modelos de produto (descrição) distintos vendidos, independente do tamanho.
	measure 'Produtos Vendidos' = COUNTROWS ( SUMMARIZE ( fVendas, dProduto[descricao] ) )
		formatString: #,0
		displayFolder: 00 Base
		lineageTag: b9100257-f078-468e-bb89-64fd550a1b41

	/// Faturamento por nota fiscal.
	measure 'Ticket Médio' = DIVIDE ( [Faturamento], [Pedidos] )
		formatString: \R$ #,0;-\R$ #,0
		displayFolder: 00 Base
		lineageTag: 57cf30e9-97ab-4d31-bd91-18ae4368b489

	/// Faturamento por item vendido.
	measure 'Preço Médio' = DIVIDE ( [Faturamento], [Quantidade] )
		formatString: \R$ #,0.00;-\R$ #,0.00
		displayFolder: 00 Base
		lineageTag: 792cab68-dfc7-4b89-a3da-64bbdfe5b771

	measure 'Itens por Pedido' = DIVIDE ( [Quantidade], [Pedidos] )
		formatString: #,0.0
		displayFolder: 00 Base
		lineageTag: 70d904b0-79dc-416e-a43a-6791f947f3be

	/// Custo dos itens vendidos (quantidade × custo unitário do produto).
	measure Custo = SUMX ( fVendas, fVendas[item_quantidade] * RELATED ( dProduto[custoUnitario] ) )
		formatString: \R$ #,0;-\R$ #,0
		displayFolder: 00 Base
		lineageTag: 07e973f0-6ea7-4532-b6a5-aa43ea4e99da

	measure 'Margem Bruta' = [Faturamento] - [Custo]
		formatString: \R$ #,0;-\R$ #,0
		displayFolder: 00 Base
		lineageTag: bb01a330-21ff-4a71-9d73-88490387cfb2

	measure 'Margem %' = DIVIDE ( [Margem Bruta], [Faturamento] )
		formatString: 0.0%
		displayFolder: 00 Base
		lineageTag: a6841278-8df1-4658-8b67-27db8b3fee4c

	measure Desconto = SUM ( fVendas[valor_desconto] )
		formatString: \R$ #,0;-\R$ #,0
		displayFolder: 00 Base
		lineageTag: 3c30c24e-8272-4a02-945d-ac115d64aaab

	/// Desconto sobre o valor bruto (faturamento + desconto).
	measure 'Desconto %' = DIVIDE ( [Desconto], [Faturamento] + [Desconto] )
		formatString: 0.0%
		displayFolder: 00 Base
		lineageTag: 8d4f5104-26e3-4477-b24c-9c9a6d0d92eb

	/// Última data com venda na base inteira. É a referência de 'hoje' de todo o relatório.
	measure 'Data Última Venda' = CALCULATE ( MAX ( fVendas[data] ), REMOVEFILTERS () )
		formatString: dd/MM/yyyy
		displayFolder: 00 Base
		lineageTag: f2f25442-0c6e-4a10-b2b2-7918313aa909

	/// Meta na granularidade original: dia útil × gerente × categoria.
	measure 'Meta Base' = SUM ( fMetas[Valor] )
		formatString: \R$ #,0;-\R$ #,0
		isHidden
		displayFolder: 02 Metas\Rateio
		lineageTag: 026c2059-0d1a-4efc-b3b8-7dc6782655ab

	/// Rateio da meta do gerente entre vendedores: divisão igualitária pelo número de vendedores do gerente.
	measure 'Fator Vendedor' =
			VAR vVendedores = COUNTROWS ( dVendedor )
			VAR vVendedoresGerente =
			    CALCULATE ( COUNTROWS ( dVendedor ), ALL ( dVendedor ), VALUES ( dVendedor[gerente_id] ) )
			RETURN
			    DIVIDE ( vVendedores, vVendedoresGerente )
		formatString: 0.0%
		isHidden
		displayFolder: 02 Metas\Rateio
		lineageTag: 7cb809b6-cc86-4f36-8b19-611ed6083d6e

	/// Rateio da meta da categoria entre produtos: participação do produto no faturamento da categoria no ano anterior.
	measure 'Fator Produto' =
			VAR vFatLY = CALCULATE ( [Faturamento], PREVIOUSYEAR ( dCalendario[Data] ) )
			VAR vFatLYCategoria =
			    CALCULATE (
			        [Faturamento],
			        PREVIOUSYEAR ( dCalendario[Data] ),
			        ALL ( dProduto ),
			        VALUES ( dProduto[categoria_id] )
			    )
			RETURN
			    DIVIDE ( vFatLY, vFatLYCategoria )
		formatString: 0.00%
		isHidden
		displayFolder: 02 Metas\Rateio
		lineageTag: 505dc1d8-5395-4301-98d6-4c6c78944dc6

	/// Meta do contexto. A meta nasce por gerente × categoria × dia útil e é rateada para vendedor (igualitário) e produto (share do ano anterior). Mesma regra da medida original '$ Meta Diluída'.
	measure Meta =
			SUMX (
			    CROSSJOIN ( VALUES ( dProduto[categoria_id] ), VALUES ( dVendedor[gerente_id] ) ),
			    [Meta Base] * [Fator Produto] * [Fator Vendedor]
			)
		displayFolder: 02 Metas
		lineageTag: d4a6d2e7-c8bf-48f6-a7c0-dd1c3c51072d

		formatStringDefinition =
				VAR v = ABS ( SELECTEDMEASURE () )
				RETURN
				    SWITCH (
				        TRUE (),
				        v >= 1E6, "\R$ #,0,,.00 \M\i;-\R$ #,0,,.00 \M\i",
				        v >= 1E4, "\R$ #,0,.0 \m\i\l;-\R$ #,0,.0 \m\i\l",
				        "\R$ #,0;-\R$ #,0"
				    )

	/// Meta acumulada até a data da última venda. Base de comparação justa para o realizado de períodos em andamento.
	measure 'Meta até Hoje' = CALCULATE ( [Meta], KEEPFILTERS ( dCalendario[Passado] = TRUE () ) )
		displayFolder: 02 Metas
		lineageTag: c8449bda-babd-4655-a2d6-ff6d7adb3d20

		formatStringDefinition =
				VAR v = ABS ( SELECTEDMEASURE () )
				RETURN
				    SWITCH (
				        TRUE (),
				        v >= 1E6, "\R$ #,0,,.00 \M\i;-\R$ #,0,,.00 \M\i",
				        v >= 1E4, "\R$ #,0,.0 \m\i\l;-\R$ #,0,.0 \m\i\l",
				        "\R$ #,0;-\R$ #,0"
				    )

	/// Realizado menos meta acumulada até a última venda. Negativo = abaixo da meta.
	measure 'Gap Meta' = [Faturamento] - [Meta até Hoje]
		displayFolder: 02 Metas
		lineageTag: 8d0d086e-2a78-4695-9672-001c3552ec03

		formatStringDefinition =
				VAR v = ABS ( SELECTEDMEASURE () )
				RETURN
				    SWITCH (
				        TRUE (),
				        v >= 1E6, "+\R$ #,0,,.00 \M\i;-\R$ #,0,,.00 \M\i",
				        v >= 1E4, "+\R$ #,0,.0 \m\i\l;-\R$ #,0,.0 \m\i\l",
				        "+\R$ #,0;-\R$ #,0"
				    )

	/// Desvio percentual do realizado sobre a meta até hoje.
	measure 'Gap Meta %' = DIVIDE ( [Gap Meta], [Meta até Hoje] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 02 Metas
		lineageTag: 6d834a9d-4225-46c7-b5e0-f28c5b61286e

	/// Realizado ÷ meta acumulada até a última venda.
	measure 'Atingimento %' = DIVIDE ( [Faturamento], [Meta até Hoje] )
		formatString: 0.0%
		displayFolder: 02 Metas
		lineageTag: 16e8bb87-9c96-44ad-a91f-7944aa154559

	/// Faturamento do mesmo período do ano anterior, limitado à mesma janela já realizada (comparação like-for-like em períodos em andamento).
	measure 'Faturamento LY' =
			CALCULATE (
			    [Faturamento],
			    CALCULATETABLE ( SAMEPERIODLASTYEAR ( dCalendario[Data] ), dCalendario[Passado] = TRUE () )
			)
		displayFolder: 03 Comparações
		lineageTag: cfc789a3-aee4-472c-9e43-7527d8383b59

		formatStringDefinition =
				VAR v = ABS ( SELECTEDMEASURE () )
				RETURN
				    SWITCH (
				        TRUE (),
				        v >= 1E6, "\R$ #,0,,.00 \M\i;-\R$ #,0,,.00 \M\i",
				        v >= 1E4, "\R$ #,0,.0 \m\i\l;-\R$ #,0,.0 \m\i\l",
				        "\R$ #,0;-\R$ #,0"
				    )

	/// Variação absoluta do faturamento contra o ano anterior.
	measure 'YoY Δ' =
			VAR vLY = [Faturamento LY]
			RETURN
			    IF ( NOT ISBLANK ( vLY ) || NOT ISBLANK ( [Faturamento] ), [Faturamento] - vLY )
		displayFolder: 03 Comparações
		lineageTag: 8646f415-e794-4860-99c1-8dd5cea8b049

		formatStringDefinition =
				VAR v = ABS ( SELECTEDMEASURE () )
				RETURN
				    SWITCH (
				        TRUE (),
				        v >= 1E6, "+\R$ #,0,,.00 \M\i;-\R$ #,0,,.00 \M\i",
				        v >= 1E4, "+\R$ #,0,.0 \m\i\l;-\R$ #,0,.0 \m\i\l",
				        "+\R$ #,0;-\R$ #,0"
				    )

	measure 'YoY %' =
			VAR vLY = [Faturamento LY]
			RETURN
			    DIVIDE ( [Faturamento] - vLY, vLY )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 03 Comparações
		lineageTag: 87e529ab-1456-49e3-8775-40fb8cf503b0

	/// Faturamento do período deslocado em um mês, limitado à janela já realizada.
	measure 'Faturamento LM' =
			CALCULATE (
			    [Faturamento],
			    CALCULATETABLE ( DATEADD ( dCalendario[Data], -1, MONTH ), dCalendario[Passado] = TRUE () )
			)
		displayFolder: 03 Comparações
		lineageTag: 25d81721-e79f-4415-8ca6-5ee033c96812

		formatStringDefinition =
				VAR v = ABS ( SELECTEDMEASURE () )
				RETURN
				    SWITCH (
				        TRUE (),
				        v >= 1E6, "\R$ #,0,,.00 \M\i;-\R$ #,0,,.00 \M\i",
				        v >= 1E4, "\R$ #,0,.0 \m\i\l;-\R$ #,0,.0 \m\i\l",
				        "\R$ #,0;-\R$ #,0"
				    )

	measure 'MoM %' =
			VAR vLM = [Faturamento LM]
			RETURN
			    DIVIDE ( [Faturamento] - vLM, vLM )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 03 Comparações
		lineageTag: 4cda0027-311f-4a5f-837b-369ca21cb401

	measure 'Pedidos LY' =
			CALCULATE (
			    [Pedidos],
			    CALCULATETABLE ( SAMEPERIODLASTYEAR ( dCalendario[Data] ), dCalendario[Passado] = TRUE () )
			)
		formatString: #,0
		displayFolder: 03 Comparações
		lineageTag: 4c07c69d-31cb-4b5d-b462-61bda5233809

	measure 'Pedidos YoY %' =
			VAR vLY = [Pedidos LY]
			RETURN
			    DIVIDE ( [Pedidos] - vLY, vLY )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 03 Comparações
		lineageTag: 062ae2ee-ba79-4899-b07c-2f523f6ef9e5

	measure 'Ticket Médio LY' = DIVIDE ( [Faturamento LY], [Pedidos LY] )
		formatString: \R$ #,0;-\R$ #,0
		displayFolder: 03 Comparações
		lineageTag: bbfb81bf-1abb-41d6-ac22-7f2df6a7934d

	measure 'Ticket Médio YoY %' =
			VAR vLY = [Ticket Médio LY]
			RETURN
			    DIVIDE ( [Ticket Médio] - vLY, vLY )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 03 Comparações
		lineageTag: 68692b35-d553-4c4a-b8ab-3c7b8f1def0d

	measure 'Quantidade LY' =
			CALCULATE (
			    [Quantidade],
			    CALCULATETABLE ( SAMEPERIODLASTYEAR ( dCalendario[Data] ), dCalendario[Passado] = TRUE () )
			)
		formatString: #,0
		displayFolder: 03 Comparações
		lineageTag: d45b8a5c-b67f-4937-add2-3feb34a5516b

	measure 'Quantidade YoY %' =
			VAR vLY = [Quantidade LY]
			RETURN
			    DIVIDE ( [Quantidade] - vLY, vLY )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 03 Comparações
		lineageTag: 09a424a3-35f0-4c59-a200-d51d79fd599f

	measure 'Clientes LY' =
			CALCULATE (
			    [Clientes],
			    CALCULATETABLE ( SAMEPERIODLASTYEAR ( dCalendario[Data] ), dCalendario[Passado] = TRUE () )
			)
		formatString: #,0
		displayFolder: 03 Comparações
		lineageTag: fcc6c7f9-10d5-4784-8d03-78923777eb88

	measure 'Clientes YoY %' =
			VAR vLY = [Clientes LY]
			RETURN
			    DIVIDE ( [Clientes] - vLY, vLY )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 03 Comparações
		lineageTag: 399cb4dd-142e-4746-a940-5b3c5048abeb

	measure 'Dias do Período' = COUNTROWS ( dCalendario )
		formatString: #,0
		displayFolder: 04 Forecast\Calendário
		lineageTag: 95db2e32-68d8-4584-8d53-c709d9f4ac90

	/// Dias corridos do contexto até a última venda.
	measure 'Dias Decorridos' = CALCULATE ( COUNTROWS ( dCalendario ), KEEPFILTERS ( dCalendario[Passado] = TRUE () ) ) + 0
		formatString: #,0
		displayFolder: 04 Forecast\Calendário
		lineageTag: 05abd1ae-3097-484c-b9a0-f92efc3dbf2d

	/// Dias corridos do contexto depois da última venda.
	measure 'Dias Restantes' = [Dias do Período] - [Dias Decorridos]
		formatString: #,0
		displayFolder: 04 Forecast\Calendário
		lineageTag: 7d637b6e-f2c2-4627-bbad-a24681a88a1b

	/// Segunda a sexta, sem calendário de feriados. Mesma base usada na diluição das metas.
	measure 'Dias Úteis' = CALCULATE ( COUNTROWS ( dCalendario ), KEEPFILTERS ( dCalendario[DiaUtil] = TRUE () ) ) + 0
		formatString: #,0
		displayFolder: 04 Forecast\Calendário
		lineageTag: 8af8bff4-8598-4f94-a9b5-f0f09076a084

	measure 'Dias Úteis Decorridos' =
			CALCULATE (
			    COUNTROWS ( dCalendario ),
			    KEEPFILTERS ( dCalendario[DiaUtil] = TRUE () ),
			    KEEPFILTERS ( dCalendario[Passado] = TRUE () )
			) + 0
		formatString: #,0
		displayFolder: 04 Forecast\Calendário
		lineageTag: edef714f-c3b8-48c1-a68e-9eea773a37dd

	measure 'Dias Úteis Restantes' = [Dias Úteis] - [Dias Úteis Decorridos]
		formatString: #,0
		displayFolder: 04 Forecast\Calendário
		lineageTag: a164badc-bc07-4dea-bf84-37b7c19e4554

	/// Meta do período ÷ dias úteis do período.
	measure 'Meta Diária Original' = DIVIDE ( [Meta], [Dias Úteis] )
		formatString: \R$ #,0;-\R$ #,0
		displayFolder: 04 Forecast\Ritmo
		lineageTag: efd42aa5-a397-48ce-8474-71b03677aee7

	/// Faturamento ÷ dias úteis decorridos. Usa a mesma base da meta diária para a comparação ser justa (vendas de fim de semana entram no numerador).
	measure 'Realizado Diário Médio' = DIVIDE ( [Faturamento], [Dias Úteis Decorridos] )
		formatString: \R$ #,0;-\R$ #,0
		displayFolder: 04 Forecast\Ritmo
		lineageTag: 3c30b1b9-6245-4417-9b1e-93a87a671809

	/// Quanto é preciso faturar por dia útil restante para fechar o período na meta. Equivale à 'Meta Diária Nova' original, agora numérica.
	measure 'Meta Diária Necessária' =
			VAR vRestantes = [Dias Úteis Restantes]
			RETURN
			    IF ( vRestantes > 0, MAX ( 0, DIVIDE ( [Meta] - [Faturamento], vRestantes ) ) )
		formatString: \R$ #,0;-\R$ #,0
		displayFolder: 04 Forecast\Ritmo
		lineageTag: 862eb765-c615-4c0f-b9dd-234a4880d852

	/// Ritmo diário realizado contra o ritmo necessário para bater a meta. Negativo = ritmo insuficiente.
	measure 'Ritmo vs Necessário %' =
			VAR vNec = [Meta Diária Necessária]
			RETURN
			    DIVIDE ( [Realizado Diário Médio] - vNec, vNec )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 04 Forecast\Ritmo
		lineageTag: b82182b5-3fe0-49b6-b79d-5afed70fa1ad

	measure 'Ritmo vs Original %' =
			VAR vOrig = [Meta Diária Original]
			RETURN
			    DIVIDE ( [Realizado Diário Médio] - vOrig, vOrig )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 04 Forecast\Ritmo
		lineageTag: 3ed47398-dcb9-4e89-903c-c06bdf648b56

	/// Projeção apenas dos dias futuros do contexto, pelo método escolhido em pForecast (padrão: Adaptativo). Não é modelo estatístico: são heurísticas de ritmo e sazonalidade.
	measure 'Forecast Restante' =
			VAR vRef = [Data Última Venda]
			VAR vFuturo = FILTER ( VALUES ( dCalendario[Data] ), dCalendario[Data] > vRef )
			VAR vN = COUNTROWS ( vFuturo )
			RETURN
			    IF (
			        vN > 0,
			        VAR vMetodo = SELECTEDVALUE ( pForecast[Método], "Adaptativo" )
			        VAR vIniMes = DATE ( YEAR ( vRef ), MONTH ( vRef ), 1 )
			        VAR vDiaRef = DAY ( vRef )
			        VAR vDiasMes = DAY ( EOMONTH ( vRef, 0 ) )
			        -- Run rate: média diária (dias corridos) do mês em andamento
			        VAR vMTD =
			            CALCULATE (
			                [Faturamento],
			                REMOVEFILTERS ( dCalendario ),
			                dCalendario[Data] >= vIniMes,
			                dCalendario[Data] <= vRef
			            )
			        VAR vRunRate = DIVIDE ( vMTD, vDiaRef ) * vN
			        -- Média móvel: 4 semanas completas
			        VAR vMediaMovel =
			            DIVIDE (
			                CALCULATE (
			                    [Faturamento],
			                    REMOVEFILTERS ( dCalendario ),
			                    dCalendario[Data] > vRef - 28,
			                    dCalendario[Data] <= vRef
			                ),
			                28
			            ) * vN
			        -- Sazonal: mesmos dias do ano anterior × crescimento dos últimos 90 dias
			        VAR vCrescimento =
			            DIVIDE (
			                CALCULATE (
			                    [Faturamento],
			                    REMOVEFILTERS ( dCalendario ),
			                    dCalendario[Data] > vRef - 90,
			                    dCalendario[Data] <= vRef
			                ),
			                CALCULATE (
			                    [Faturamento],
			                    REMOVEFILTERS ( dCalendario ),
			                    dCalendario[Data] > EDATE ( vRef, -12 ) - 90,
			                    dCalendario[Data] <= EDATE ( vRef, -12 )
			                )
			            )
			        VAR vFuturoLY =
			            CALCULATE (
			                [Faturamento],
			                REMOVEFILTERS ( dCalendario ),
			                TREATAS (
			                    SELECTCOLUMNS ( vFuturo, "d", EDATE ( dCalendario[Data], -12 ) ),
			                    dCalendario[Data]
			                )
			            )
			        VAR vSazonal = vFuturoLY * vCrescimento
			        -- Adaptativo: quanto mais avançado o mês, mais peso para o ritmo observado
			        VAR vPeso = DIVIDE ( vDiaRef, vDiasMes )
			        VAR vAdaptativo =
			            IF ( ISBLANK ( vSazonal ), vRunRate, vPeso * vRunRate + ( 1 - vPeso ) * vSazonal )
			        -- Plano: lógica original do relatório (dias futuros fecham na meta)
			        VAR vPlano = CALCULATE ( [Meta], KEEPFILTERS ( dCalendario[Passado] = FALSE () ) )
			        RETURN
			            SWITCH (
			                vMetodo,
			                "Run Rate", vRunRate,
			                "Média Móvel 28d", vMediaMovel,
			                "Sazonal", vSazonal,
			                "Plano de Metas", vPlano,
			                vAdaptativo
			            )
			    )
		formatString: \R$ #,0;-\R$ #,0
		isHidden
		displayFolder: 04 Forecast
		lineageTag: 484da279-c389-49d3-bc6a-d0e27d8f5e98

	/// Previsão de fechamento do período: realizado + projeção dos dias restantes pelo método selecionado. Em períodos encerrados é igual ao faturamento.
	measure Forecast = [Faturamento] + [Forecast Restante]
		displayFolder: 04 Forecast
		lineageTag: 6034a127-e58b-4271-aa5c-430cc4f629da

		formatStringDefinition =
				VAR v = ABS ( SELECTEDMEASURE () )
				RETURN
				    SWITCH (
				        TRUE (),
				        v >= 1E6, "\R$ #,0,,.00 \M\i;-\R$ #,0,,.00 \M\i",
				        v >= 1E4, "\R$ #,0,.0 \m\i\l;-\R$ #,0,.0 \m\i\l",
				        "\R$ #,0;-\R$ #,0"
				    )

	/// Forecast pelo método original do relatório (realizado + meta dos dias restantes), independente do parâmetro. Mantido para comparação antes × depois.
	measure 'Forecast Plano' = [Faturamento] + CALCULATE ( [Meta], KEEPFILTERS ( dCalendario[Passado] = FALSE () ) )
		displayFolder: 04 Forecast
		lineageTag: a899c955-a0fd-428d-beac-7b4161559799

		formatStringDefinition =
				VAR v = ABS ( SELECTEDMEASURE () )
				RETURN
				    SWITCH (
				        TRUE (),
				        v >= 1E6, "\R$ #,0,,.00 \M\i;-\R$ #,0,,.00 \M\i",
				        v >= 1E4, "\R$ #,0,.0 \m\i\l;-\R$ #,0,.0 \m\i\l",
				        "\R$ #,0;-\R$ #,0"
				    )

	/// Gap previsto no fechamento: forecast menos meta do período.
	measure 'Forecast x Meta' = [Forecast] - [Meta]
		displayFolder: 04 Forecast
		lineageTag: 285575cd-951e-4662-bf77-9daa3d6eb29d

		formatStringDefinition =
				VAR v = ABS ( SELECTEDMEASURE () )
				RETURN
				    SWITCH (
				        TRUE (),
				        v >= 1E6, "+\R$ #,0,,.00 \M\i;-\R$ #,0,,.00 \M\i",
				        v >= 1E4, "+\R$ #,0,.0 \m\i\l;-\R$ #,0,.0 \m\i\l",
				        "+\R$ #,0;-\R$ #,0"
				    )

	measure 'Forecast x Meta %' = DIVIDE ( [Forecast x Meta], [Meta] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 04 Forecast
		lineageTag: 577ed1c2-33aa-4c55-87f8-8581f59f1de1

	/// Forecast ÷ meta do período.
	measure 'Atingimento Forecast %' = DIVIDE ( [Forecast], [Meta] )
		formatString: 0.0%
		displayFolder: 04 Forecast
		lineageTag: da143e90-c79f-4252-a60f-ff9bdc7c749a

	/// Faturamento acumulado dentro do período selecionado. Fica em branco depois da última venda.
	measure 'Realizado Acumulado' =
			VAR vMax = MAX ( dCalendario[Data] )
			VAR vMin = MIN ( dCalendario[Data] )
			VAR vRef = [Data Última Venda]
			RETURN
			    IF (
			        vMin <= vRef,
			        CALCULATE (
			            [Faturamento],
			            FILTER ( ALLSELECTED ( dCalendario ), dCalendario[Data] <= vMax )
			        )
			    )
		formatString: \R$ #,0;-\R$ #,0
		displayFolder: 04 Forecast\Curvas
		lineageTag: 1027b7ea-768a-4956-ac0c-373770e3ecb0

	/// Meta acumulada dentro do período selecionado.
	measure 'Meta Acumulada' =
			VAR vMax = MAX ( dCalendario[Data] )
			RETURN
			    CALCULATE ( [Meta], FILTER ( ALLSELECTED ( dCalendario ), dCalendario[Data] <= vMax ) )
		formatString: \R$ #,0;-\R$ #,0
		displayFolder: 04 Forecast\Curvas
		lineageTag: 3029b0b0-d7f2-42e8-b9ca-88a01f20fe30

	/// Trajetória projetada: parte do realizado na última venda e acumula a projeção dos dias seguintes. Em branco antes da última venda.
	measure 'Forecast Acumulado' =
			VAR vMax = MAX ( dCalendario[Data] )
			VAR vRef = [Data Última Venda]
			RETURN
			    IF (
			        vMax >= vRef,
			        CALCULATE (
			            [Forecast],
			            FILTER ( ALLSELECTED ( dCalendario ), dCalendario[Data] <= vMax )
			        )
			    )
		formatString: \R$ #,0;-\R$ #,0
		displayFolder: 04 Forecast\Curvas
		lineageTag: 7956765d-54f7-4334-8845-26087f959682

	/// Faturamento médio do mês do ano ÷ média de todos os meses completos do histórico. 1,10 = mês tipicamente 10% acima da média.
	measure 'Índice Sazonal' =
			VAR vPrimeira = CALCULATE ( MIN ( fVendas[data] ), REMOVEFILTERS () )
			VAR vRef = [Data Última Venda]
			VAR vMeses =
			    CALCULATETABLE (
			        ADDCOLUMNS (
			            SUMMARIZE ( dCalendario, dCalendario[AnoMesINT], dCalendario[MesNum] ),
			            "@Fat", [Faturamento]
			        ),
			        REMOVEFILTERS ( dCalendario ),
			        dCalendario[Data] > EOMONTH ( vPrimeira, 0 ),
			        dCalendario[Data] <= EOMONTH ( vRef, -1 )
			    )
			VAR vMediaGeral = AVERAGEX ( vMeses, [@Fat] )
			VAR vMesesContexto = FILTER ( vMeses, dCalendario[MesNum] IN VALUES ( dCalendario[MesNum] ) )
			RETURN
			    DIVIDE ( AVERAGEX ( vMesesContexto, [@Fat] ), vMediaGeral )
		formatString: 0.00
		displayFolder: 04 Forecast\Sazonalidade
		lineageTag: c7edd763-c289-4f32-9a80-55900a6766dc

	/// Faturamento médio do dia da semana ÷ média diária geral, nos últimos 365 dias. Mostra se o fim de semana vende menos que os dias úteis.
	measure 'Índice Dia da Semana' =
			VAR vRef = [Data Última Venda]
			VAR vDias =
			    CALCULATETABLE (
			        ADDCOLUMNS (
			            SUMMARIZE ( dCalendario, dCalendario[Data], dCalendario[DiaSemana] ),
			            "@Fat", [Faturamento] + 0
			        ),
			        REMOVEFILTERS ( dCalendario ),
			        dCalendario[Data] > vRef - 364,
			        dCalendario[Data] <= vRef
			    )
			VAR vMediaGeral = AVERAGEX ( vDias, [@Fat] )
			VAR vDiasContexto = FILTER ( vDias, dCalendario[DiaSemana] IN VALUES ( dCalendario[DiaSemana] ) )
			RETURN
			    DIVIDE ( AVERAGEX ( vDiasContexto, [@Fat] ), vMediaGeral )
		formatString: 0.00
		displayFolder: 04 Forecast\Sazonalidade
		lineageTag: b18b1ee2-5282-4d23-a9cd-11036826c7c0

	/// Participação do produto no faturamento dos produtos selecionados.
	measure 'Participação %' = DIVIDE ( [Faturamento], CALCULATE ( [Faturamento], ALLSELECTED ( dProduto ) ) )
		formatString: 0.0%
		displayFolder: 05 Produtos
		lineageTag: a4ab54ff-7d14-4406-8983-542c0c1a4ca8

	measure 'Rank Produto' =
			VAR vAtual = [Faturamento]
			VAR vProdutos = CALCULATETABLE ( ADDCOLUMNS ( VALUES ( dProduto[descricao] ), "@Fat", [Faturamento] ), ALLSELECTED ( dProduto ) )
			RETURN
			    IF ( NOT ISBLANK ( vAtual ), COUNTROWS ( FILTER ( vProdutos, [@Fat] > vAtual ) ) + 1 )
		formatString: 0
		displayFolder: 05 Produtos
		lineageTag: d703e5a8-d3d9-4ede-9a85-c548c8ae3656

	/// Participação acumulada no faturamento, do maior produto para o menor (modelo de produto, sem tamanho).
	measure 'Pareto %' =
			VAR vAtual = [Faturamento]
			VAR vProdutos = CALCULATETABLE ( ADDCOLUMNS ( VALUES ( dProduto[descricao] ), "@Fat", [Faturamento] ), ALLSELECTED ( dProduto ) )
			RETURN
			    IF (
			        NOT ISBLANK ( vAtual ),
			        DIVIDE ( SUMX ( FILTER ( vProdutos, [@Fat] >= vAtual ), [@Fat] ), SUMX ( vProdutos, [@Fat] ) )
			    )
		formatString: 0.0%
		displayFolder: 05 Produtos
		lineageTag: da4824e7-0797-4227-829c-0aced8d0c9d9

	/// A: até 80% do faturamento acumulado. B: de 80% a 95%. C: restante.
	measure 'Classe ABC' =
			VAR vPareto = [Pareto %]
			RETURN
			    SWITCH ( TRUE (), ISBLANK ( vPareto ), BLANK (), vPareto <= 0.8, "A", vPareto <= 0.95, "B", "C" )
		displayFolder: 05 Produtos
		lineageTag: 601d5fbb-fb2d-4546-a334-2daa55e6831a

	/// Quantos modelos de produto somam 80% do faturamento.
	measure 'Produtos Classe A' = COUNTROWS ( FILTER ( VALUES ( dProduto[descricao] ), [Classe ABC] = "A" ) )
		formatString: 0
		displayFolder: 05 Produtos
		lineageTag: 14950bac-f4ad-401f-baa0-7a49e7a436fb

	/// Participação dos 10 maiores modelos de produto no faturamento.
	measure 'Share Top 10 %' =
			VAR vProdutos = CALCULATETABLE ( ADDCOLUMNS ( VALUES ( dProduto[descricao] ), "@Fat", [Faturamento] ), ALLSELECTED ( dProduto ) )
			RETURN
			    DIVIDE ( SUMX ( TOPN ( 10, vProdutos, [@Fat] ), [@Fat] ), SUMX ( vProdutos, [@Fat] ) )
		formatString: 0.0%
		displayFolder: 05 Produtos
		lineageTag: 7883e479-1270-4af9-9164-7be4dfab8b49

	/// Clientes que compraram o produto ÷ clientes ativos no período.
	measure 'Penetração %' = DIVIDE ( [Clientes], CALCULATE ( [Clientes], ALLSELECTED ( dProduto ) ) )
		formatString: 0.0%
		displayFolder: 05 Produtos
		lineageTag: 6d7cd731-b236-49d3-aac3-58e6f93a0398

	/// Variação da penetração contra o mesmo período do ano anterior, em pontos percentuais.
	measure 'Penetração Δ pp' =
			VAR vLY = DIVIDE ( [Clientes LY], CALCULATE ( [Clientes LY], ALLSELECTED ( dProduto ) ) )
			RETURN
			    IF ( NOT ISBLANK ( vLY ) && NOT ISBLANK ( [Penetração %] ), ( [Penetração %] - vLY ) * 100 )
		formatString: +0.0 pp;-0.0 pp;0.0 pp
		displayFolder: 05 Produtos
		lineageTag: 2ec4820c-3cca-4fe0-826a-a099f086872b

	/// Quantos pontos percentuais do crescimento total vêm deste item (variação absoluta ÷ faturamento total do ano anterior). A soma dos itens é o YoY % total.
	measure 'Contribuição Crescimento pp' =
			DIVIDE (
			    [YoY Δ],
			    CALCULATE ( [Faturamento LY], ALLSELECTED ( dProduto ), ALLSELECTED ( dVendedor ) )
			) * 100
		formatString: +0.0 pp;-0.0 pp;0.0 pp
		displayFolder: 05 Produtos
		lineageTag: 5abc1963-159c-4c1c-8c87-29cb3dad513e

	/// Matriz de performance: participação acima/abaixo da média dos produtos × crescimento acima/abaixo do crescimento total (ou seja, ganhando ou perdendo participação). Estrela: grande e ganhando share. Crescimento: pequeno e ganhando share. Atenção: grande e perdendo share. Baixa relevância: pequeno e perdendo share.
	measure 'Quadrante Produto' =
			VAR vShare = [Participação %]
			VAR vCresc = [YoY %]
			VAR vCrescTotal = [YoY Total Produtos %]
			VAR vShareMedio = [Participação Média %]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( vShare ), BLANK (),
			        ISBLANK ( vCresc ), "Novo no período",
			        vCresc >= vCrescTotal && vShare >= vShareMedio, "Estrela",
			        vCresc >= vCrescTotal, "Crescimento",
			        vShare >= vShareMedio, "Atenção",
			        "Baixa relevância"
			    )
		displayFolder: 05 Produtos
		lineageTag: 4a91fd0e-ccdc-40f7-aa6a-815dfee2a2ce

	measure 'Cor Quadrante' =
			SWITCH (
			    [Quadrante Produto],
			    "Estrela", "#39D98A",
			    "Crescimento", "#22C7BE",
			    "Atenção", "#FF7A68",
			    "Baixa relevância", "#6B7694",
			    "#8B5CF6"
			)
		displayFolder: 09 UX\Cores
		lineageTag: 4e9786fb-5087-4f6d-8d56-71f789ab563a

	/// Clientes que compraram o produto âncora (dProdutoBase) no período.
	measure 'Clientes Produto Base' =
			CALCULATE (
			    [Clientes],
			    REMOVEFILTERS ( dProduto ),
			    TREATAS ( VALUES ( dProdutoBase[Produto Base] ), dProduto[descricao] )
			)
		formatString: #,0
		displayFolder: 05 Produtos\Afinidade
		lineageTag: 3601b49e-d280-483d-babf-444916621300

	/// Clientes do produto âncora que também compraram o produto da linha no período.
	measure 'Clientes Também Compraram' =
			IF (
			    HASONEVALUE ( dProdutoBase[Produto Base] )
			        && SELECTEDVALUE ( dProduto[descricao] ) <> SELECTEDVALUE ( dProdutoBase[Produto Base] ),
			    VAR vClientesBase =
			        CALCULATETABLE (
			            VALUES ( fVendas[cliente_id] ),
			            REMOVEFILTERS ( dProduto ),
			            TREATAS ( VALUES ( dProdutoBase[Produto Base] ), dProduto[descricao] )
			        )
			    RETURN
			        CALCULATE ( [Clientes], KEEPFILTERS ( vClientesBase ) )
			)
		formatString: #,0
		displayFolder: 05 Produtos\Afinidade
		lineageTag: adc13d3d-c9ec-4e18-92b5-4761c363feef

	/// Dos clientes que compraram o produto âncora, quantos % também compraram este produto. É frequência observada, não probabilidade.
	measure '% Também Compraram' = DIVIDE ( [Clientes Também Compraram], [Clientes Produto Base] )
		formatString: 0%
		displayFolder: 05 Produtos\Afinidade
		lineageTag: 3a336486-5c8f-4a32-a4fc-9ceaa0159cbe

	/// % Também Compraram ÷ penetração geral do produto. Acima de 1 = os clientes do produto âncora compram este item mais do que a base em geral.
	measure 'Lift Afinidade' =
			VAR vPenetracaoGeral =
			    DIVIDE ( [Clientes], CALCULATE ( [Clientes], REMOVEFILTERS ( dProduto ) ) )
			RETURN
			    IF ( NOT ISBLANK ( [% Também Compraram] ), DIVIDE ( [% Também Compraram], vPenetracaoGeral ) )
		formatString: 0.00x
		displayFolder: 05 Produtos\Afinidade
		lineageTag: 15cb3d0d-c476-4556-80de-c2c286a08e10

	/// Clientes cuja primeira compra de todo o histórico caiu no período.
	measure 'Clientes Novos' =
			CALCULATE (
			    COUNTROWS ( dCliente ),
			    TREATAS ( VALUES ( dCalendario[Data] ), dCliente[Primeira Compra] )
			)
		formatString: #,0
		displayFolder: 06 Clientes
		lineageTag: 9bfd4a35-efa1-4169-a8b4-93620834bb2a

	measure 'Clientes Recorrentes' = [Clientes] - [Clientes Novos]
		formatString: #,0
		displayFolder: 06 Clientes
		lineageTag: 249d79ac-4643-4c56-8692-2c01be18508e

	/// Clientes que compraram no mesmo período do ano anterior e não compraram no período atual.
	measure 'Clientes Sem Recompra' =
			VAR vAtuais = VALUES ( fVendas[cliente_id] )
			VAR vAnteriores =
			    CALCULATETABLE (
			        VALUES ( fVendas[cliente_id] ),
			        CALCULATETABLE ( SAMEPERIODLASTYEAR ( dCalendario[Data] ), dCalendario[Passado] = TRUE () )
			    )
			RETURN
			    COUNTROWS ( EXCEPT ( vAnteriores, vAtuais ) )
		formatString: #,0
		displayFolder: 06 Clientes
		lineageTag: 0fde8aa9-393c-497d-bc1e-fa90fe6bcecc

	/// Concentração: participação dos 10 maiores clientes no faturamento.
	measure 'Share Top 10 Clientes %' =
			VAR vClientes = ADDCOLUMNS ( ALLSELECTED ( dCliente[id] ), "@Fat", [Faturamento] )
			RETURN
			    DIVIDE ( SUMX ( TOPN ( 10, vClientes, [@Fat] ), [@Fat] ), SUMX ( vClientes, [@Fat] ) )
		formatString: 0.0%
		displayFolder: 06 Clientes
		lineageTag: 121eb727-bc54-4b88-9158-2bbddf54db56

	/// Clientes com pelo menos uma compra no histórico (foto na data da última venda; não depende do período).
	measure 'Clientes na Carteira' =
			CALCULATE (
			    COUNTROWS ( dCliente ),
			    NOT ISBLANK ( dCliente[Última Compra] ),
			    REMOVEFILTERS ( dCalendario )
			)
		formatString: #,0
		displayFolder: 06 Clientes\RFV (foto 12M)
		lineageTag: 53b4df48-1c57-466e-a070-17a262e9c29e

	measure 'Carteira %' =
			DIVIDE (
			    [Clientes na Carteira],
			    CALCULATE ( [Clientes na Carteira], ALLSELECTED ( pSegmento ), ALLSELECTED ( dCliente[Segmento RFV] ) )
			)
		formatString: 0.0%
		displayFolder: 06 Clientes\RFV (foto 12M)
		lineageTag: 0d973bac-c045-48d1-823b-d3a233a6fee6

	/// Faturamento dos 12 meses até a última venda, independente do período selecionado.
	measure 'Faturamento 12M' =
			VAR vRef = [Data Última Venda]
			RETURN
			    CALCULATE (
			        [Faturamento],
			        REMOVEFILTERS ( dCalendario ),
			        dCalendario[Data] > EDATE ( vRef, -12 ),
			        dCalendario[Data] <= vRef
			    )
		displayFolder: 06 Clientes\RFV (foto 12M)
		lineageTag: 86394e1d-6d23-4f6f-97b4-67e3376d5add

		formatStringDefinition =
				VAR v = ABS ( SELECTEDMEASURE () )
				RETURN
				    SWITCH (
				        TRUE (),
				        v >= 1E6, "\R$ #,0,,.00 \M\i;-\R$ #,0,,.00 \M\i",
				        v >= 1E4, "\R$ #,0,.0 \m\i\l;-\R$ #,0,.0 \m\i\l",
				        "\R$ #,0;-\R$ #,0"
				    )

	measure 'Pedidos 12M' =
			VAR vRef = [Data Última Venda]
			RETURN
			    CALCULATE (
			        [Pedidos],
			        REMOVEFILTERS ( dCalendario ),
			        dCalendario[Data] > EDATE ( vRef, -12 ),
			        dCalendario[Data] <= vRef
			    )
		formatString: #,0
		displayFolder: 06 Clientes\RFV (foto 12M)
		lineageTag: 51cfa4a9-6d60-4de3-8264-23d05e0e23b0

	measure 'Ticket Médio 12M' = DIVIDE ( [Faturamento 12M], [Pedidos 12M] )
		formatString: \R$ #,0;-\R$ #,0
		displayFolder: 06 Clientes\RFV (foto 12M)
		lineageTag: 22316ca9-cfe5-4a1f-bedb-680c5dd80884

	/// Mix: SKUs distintos comprados nos últimos 12 meses.
	measure 'SKUs 12M' =
			VAR vRef = [Data Última Venda]
			RETURN
			    CALCULATE (
			        [SKUs Vendidos],
			        REMOVEFILTERS ( dCalendario ),
			        dCalendario[Data] > EDATE ( vRef, -12 ),
			        dCalendario[Data] <= vRef
			    )
		formatString: #,0
		displayFolder: 06 Clientes\RFV (foto 12M)
		lineageTag: a361d5f8-54c4-4ea1-bb80-7dafd3f64a4b

	measure 'Última Compra Cliente' = CALCULATE ( MAX ( fVendas[data] ), REMOVEFILTERS ( dCalendario ) )
		formatString: dd/MM/yyyy
		displayFolder: 06 Clientes\RFV (foto 12M)
		lineageTag: a15c441d-22f5-4fd9-8d9c-05b25f11983a

	/// Média de dias desde a última compra dos clientes do contexto.
	measure 'Recência Média (dias)' = CALCULATE ( AVERAGE ( dCliente[Recência (dias)] ), REMOVEFILTERS ( dCalendario ) )
		formatString: #,0
		displayFolder: 06 Clientes\RFV (foto 12M)
		lineageTag: 8d86c287-aa72-49b9-a475-11900d8a4c4c

	/// Faturamento 12M dos clientes classificados como 'Em risco' (181 a 365 dias sem comprar).
	measure 'Faturamento 12M em Risco' = CALCULATE ( [Faturamento 12M], dCliente[Segmento RFV] = "Em risco" )
		displayFolder: 06 Clientes\RFV (foto 12M)
		lineageTag: b69ffb56-08e7-4137-9bad-2d1707811ef3

		formatStringDefinition =
				VAR v = ABS ( SELECTEDMEASURE () )
				RETURN
				    SWITCH (
				        TRUE (),
				        v >= 1E6, "\R$ #,0,,.00 \M\i;-\R$ #,0,,.00 \M\i",
				        v >= 1E4, "\R$ #,0,.0 \m\i\l;-\R$ #,0,.0 \m\i\l",
				        "\R$ #,0;-\R$ #,0"
				    )

	measure 'Clientes em Risco' = CALCULATE ( [Clientes na Carteira], dCliente[Segmento RFV] = "Em risco" )
		formatString: #,0
		displayFolder: 06 Clientes\RFV (foto 12M)
		lineageTag: ec77120d-e546-4d25-a96e-eff9dfa964e0

	measure 'Cliente Selecionado' = SELECTEDVALUE ( dCliente[descricao], "Selecione um cliente" )
		displayFolder: 07 Recomendação\Perfil
		lineageTag: 262ee83c-7efd-4686-897a-0b71640f70f5

	measure 'Segmento Cliente' = SELECTEDVALUE ( dCliente[Segmento RFV], "—" )
		displayFolder: 07 Recomendação\Perfil
		lineageTag: b8735738-4d32-4605-a978-b60d60c08286

	measure 'Recência Cliente (dias)' = IF ( HASONEVALUE ( dCliente[id] ), SELECTEDVALUE ( dCliente[Recência (dias)] ) )
		formatString: #,0 \d\i\a\s
		displayFolder: 07 Recomendação\Perfil
		lineageTag: 4df95dc6-6031-4776-b42e-c64ad4f43d08

	/// Ação comercial padrão do segmento RFV do cliente selecionado.
	measure 'Ação Segmento' =
			IF (
			    HASONEVALUE ( dCliente[id] ),
			    LOOKUPVALUE ( pSegmento[Ação sugerida], pSegmento[Segmento], SELECTEDVALUE ( dCliente[Segmento RFV] ) )
			)
		displayFolder: 07 Recomendação\Perfil
		lineageTag: f836ea94-a112-40d4-ad0d-8d8f27792ac6

	/// Quantidade de clientes similares ao selecionado (até 3, similaridade de cosseno do mix de compras entre 0,50 e 0,99).
	measure 'Clientes Similares' = IF ( HASONEVALUE ( dCliente[id] ), COUNTROWS ( VALUES ( fSimilaridadeClientes[similar] ) ) + 0 )
		formatString: 0
		displayFolder: 07 Recomendação\Similares
		lineageTag: 9d1222de-7477-4fb2-85a4-8308d3fdb058

	/// Similaridade de cosseno entre o mix de compras (quantidade por SKU no ano corrente) do cliente e do similar. Calculada em Python no Power Query. É um índice de semelhança de 0 a 1, não uma probabilidade.
	measure Similaridade = AVERAGE ( fSimilaridadeClientes[valor] )
		formatString: 0%
		displayFolder: 07 Recomendação\Similares
		lineageTag: 1844a725-74f1-42a0-b6de-f6d1c5e13d2a

	/// Faturamento 12M do cliente similar (linha de dClienteSimilar).
	measure 'Faturamento Similar 12M' =
			IF (
			    NOT ISBLANK ( [Similaridade] ),
			    CALCULATE ( [Faturamento 12M], REMOVEFILTERS ( dCliente ) )
			)
		formatString: \R$ #,0;-\R$ #,0
		displayFolder: 07 Recomendação\Similares
		lineageTag: 12ebfbac-73e1-4eeb-aad7-2de18bcf4cf1

	measure 'SKUs Similar 12M' = IF ( NOT ISBLANK ( [Similaridade] ), CALCULATE ( [SKUs 12M], REMOVEFILTERS ( dCliente ) ) )
		formatString: #,0
		displayFolder: 07 Recomendação\Similares
		lineageTag: 20406b61-7dcc-4340-bbef-2e5fd16bd10d

	/// Itens do produto comprados pelos clientes similares no período. Equivale à medida original 'Itens Comprados Clientes Similares'.
	measure 'Qtd Comprada Similares' =
			CALCULATE (
			    [Quantidade],
			    REMOVEFILTERS ( dCliente ),
			    TREATAS ( VALUES ( fSimilaridadeClientes[similar] ), fVendas[cliente_id] )
			)
		formatString: #,0
		displayFolder: 07 Recomendação\Next Best Product
		lineageTag: 2f6f2da0-75e0-4511-bc70-d553873d27e3

	/// Quantos dos clientes similares compraram o produto no período.
	measure 'Similares que Compraram' =
			CALCULATE (
			    [Clientes],
			    REMOVEFILTERS ( dCliente ),
			    TREATAS ( VALUES ( fSimilaridadeClientes[similar] ), fVendas[cliente_id] )
			)
		formatString: 0
		displayFolder: 07 Recomendação\Next Best Product
		lineageTag: 886fa402-c8dd-4233-be91-fbb43a20ac0e

	/// Itens comprados pelos similares em produtos que o cliente ainda não comprou no período. Mesma regra da medida original 'Qtd Itens Recomendados Similiradidade'.
	measure 'Qtd Recomendada Similares' = IF ( HASONEVALUE ( dCliente[id] ) && ISBLANK ( [Quantidade] ), [Qtd Comprada Similares] )
		formatString: #,0
		displayFolder: 07 Recomendação\Next Best Product
		lineageTag: 608280e3-c2c1-4706-ab50-fbd53fd8d409

	/// Score heurístico de 0 a 100 para produtos que o cliente NÃO comprou no período: 75% = penetração do produto entre os clientes similares, ponderada pela similaridade de cada um; 25% = penetração do produto na base ativa. Serve para ordenar oportunidades. Não é probabilidade de compra.
	measure 'Score Recomendação' =
			IF (
			    HASONEVALUE ( dCliente[id] ) && ISBLANK ( [Quantidade] ),
			    VAR vSimilares =
			        SELECTCOLUMNS (
			            fSimilaridadeClientes,
			            "@Cliente", fSimilaridadeClientes[similar],
			            "@Peso", fSimilaridadeClientes[valor]
			        )
			    VAR vPesoTotal = SUMX ( vSimilares, [@Peso] )
			    VAR vPesoComprou =
			        SUMX (
			            vSimilares,
			            VAR vCli = [@Cliente]
			            RETURN
			                IF (
			                    CALCULATE (
			                        NOT ISEMPTY ( fVendas ),
			                        REMOVEFILTERS ( dCliente ),
			                        REMOVEFILTERS ( fSimilaridadeClientes ),
			                        fVendas[cliente_id] = vCli
			                    ),
			                    [@Peso]
			                )
			        )
			    VAR vPenetracaoSimilares = DIVIDE ( vPesoComprou, vPesoTotal )
			    VAR vPenetracaoBase =
			        DIVIDE (
			            CALCULATE ( [Clientes], REMOVEFILTERS ( dCliente ) ),
			            CALCULATE ( [Clientes], REMOVEFILTERS ( dCliente ), REMOVEFILTERS ( dProduto ) )
			        )
			    RETURN
			        IF ( vPenetracaoSimilares > 0, ROUND ( 100 * ( 0.75 * vPenetracaoSimilares + 0.25 * vPenetracaoBase ), 0 ) )
			)
		formatString: 0
		displayFolder: 07 Recomendação\Next Best Product
		lineageTag: d5af7288-a08c-4478-a024-1813bf33b4c3

	/// Posição do produto no ranking de Next Best Product (score; desempate pelo volume comprado pelos similares).
	measure 'Rank NBP' =
			IF (
			    NOT ISBLANK ( [Score Recomendação] ),
			    RANKX (
			        ALL ( dProduto ),
			        [Score Recomendação] + DIVIDE ( [Qtd Comprada Similares], 100000 ),
			        ,
			        DESC,
			        DENSE
			    )
			)
		formatString: \#0
		displayFolder: 07 Recomendação\Next Best Product
		lineageTag: 176e39bc-d199-4f97-8304-c3fd070d596a

	/// Leitura qualitativa do score.
	measure 'Oportunidade NBP' =
			VAR vScore = [Score Recomendação]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( vScore ), BLANK (),
			        vScore >= 70, "▲ Alta",
			        vScore >= 40, "● Média",
			        "▼ Exploratória"
			    )
		displayFolder: 07 Recomendação\Next Best Product
		lineageTag: a5bccfe3-3aaf-4c0e-97e2-74c6c8d10ba0

	/// Quantidade de SKUs com score de recomendação para o cliente.
	measure 'Produtos Recomendados' =
			IF (
			    HASONEVALUE ( dCliente[id] ),
			    COUNTROWS ( FILTER ( ALL ( dProduto ), NOT ISBLANK ( [Score Recomendação] ) ) ) + 0
			)
		formatString: 0
		displayFolder: 07 Recomendação\Next Best Product
		lineageTag: 2c9b9056-9f75-4537-bf67-7c6f6211e5bd

	/// Itens do produto comprados pelo cliente em todo o histórico.
	measure 'Qtd Histórica' = CALCULATE ( [Quantidade], REMOVEFILTERS ( dCalendario ) )
		formatString: #,0
		displayFolder: 07 Recomendação\Recompra
		lineageTag: 4e685a89-7690-4d19-8370-41220aff4086

	/// Recorrência: em quantas notas do histórico o produto apareceu.
	measure 'Compras do Produto' = CALCULATE ( [Pedidos], REMOVEFILTERS ( dCalendario ) )
		formatString: #,0
		displayFolder: 07 Recomendação\Recompra
		lineageTag: bb07c4df-832f-4a71-82e8-c53c3e0a1575

	measure 'Última Compra Produto' = CALCULATE ( MAX ( fVendas[data] ), REMOVEFILTERS ( dCalendario ) )
		formatString: dd/MM/yyyy
		displayFolder: 07 Recomendação\Recompra
		lineageTag: e35215d4-c023-4b50-8458-4ab5449b3081

	measure 'Dias sem Comprar Produto' =
			VAR vUltima = [Última Compra Produto]
			RETURN
			    IF ( NOT ISBLANK ( vUltima ), DATEDIFF ( vUltima, [Data Última Venda], DAY ) )
		formatString: #,0
		displayFolder: 07 Recomendação\Recompra
		lineageTag: f26203ec-2aa6-43a3-a4fb-79b0d129af25

	/// Itens que o cliente já comprou no histórico mas não comprou no período selecionado. Mesma regra da medida original 'Qtd Itens Recomendados Histórico'.
	measure 'Qtd Recompra Sugerida' = IF ( HASONEVALUE ( dCliente[id] ) && ISBLANK ( [Quantidade] ), [Qtd Histórica] )
		formatString: #,0
		displayFolder: 07 Recomendação\Recompra
		lineageTag: cfa08495-31f7-449d-ac35-44c5e4249e7e

	/// Posição do vendedor em faturamento entre os vendedores selecionados.
	measure 'Rank Vendedor' =
			VAR vAtual = [Faturamento]
			VAR vVendedores =
			    CALCULATETABLE ( ADDCOLUMNS ( VALUES ( dVendedor[descricao] ), "@Fat", [Faturamento] ), ALLSELECTED ( dVendedor ) )
			RETURN
			    IF ( NOT ISBLANK ( vAtual ), COUNTROWS ( FILTER ( vVendedores, [@Fat] > vAtual ) ) + 1 )
		formatString: 0
		displayFolder: 08 Ranking
		lineageTag: d24be123-c1e8-4af8-b4b4-10d96954f553

	/// Status com símbolo (não depende só de cor): acima da meta (≥100%), abaixo (80% a 99,9%), em risco (<80%).
	measure 'Status Meta' =
			VAR vAting = [Atingimento %]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( vAting ), BLANK (),
			        vAting >= 1, "▲ Acima",
			        vAting >= 0.8, "▼ Abaixo",
			        "● Em risco"
			    )
		displayFolder: 08 Ranking
		lineageTag: 5515c081-fa82-4882-95f5-c4f6c576aff8

	/// Retorna 1 para os vendedores que pertencem ao recorte escolhido em pRanking. Usar como filtro de visual (= 1).
	measure 'Filtro Ranking' =
			VAR vVisao = SELECTEDVALUE ( pRanking[Visão], "Todos" )
			VAR vAting = [Atingimento %]
			RETURN
			    IF (
			        NOT ISBLANK ( [Faturamento] ),
			        SWITCH (
			            vVisao,
			            "Acima da meta", INT ( vAting >= 1 ),
			            "Abaixo da meta", INT ( vAting < 1 ),
			            "Top performers", INT ( [Rank Vendedor] <= 3 ),
			            "Em risco", INT ( vAting < 0.8 ),
			            1
			        )
			    )
		formatString: 0
		displayFolder: 08 Ranking
		lineageTag: d796e700-5b05-48cf-9e44-2d7dc60a37cc

	measure 'Vendedores Acima da Meta' = COUNTROWS ( FILTER ( VALUES ( dVendedor[descricao] ), [Atingimento %] >= 1 ) ) + 0
		formatString: 0
		displayFolder: 08 Ranking
		lineageTag: 0cb60d15-c54a-40aa-94d2-3164d04064e0

	measure 'Vendedores Ativos' = COUNTROWS ( FILTER ( VALUES ( dVendedor[descricao] ), NOT ISBLANK ( [Faturamento] ) ) ) + 0
		formatString: 0
		displayFolder: 08 Ranking
		lineageTag: f39467c4-db4e-4d15-80c0-53cf2a48674e

	measure 'Período Selecionado' =
			VAR vIni = FORMAT ( MIN ( dCalendario[Data] ), "mmm/yy" )
			VAR vFim = FORMAT ( MAX ( dCalendario[Data] ), "mmm/yy" )
			RETURN
			    IF ( vIni = vFim, vIni, vIni & " a " & vFim )
		displayFolder: 09 UX\Títulos
