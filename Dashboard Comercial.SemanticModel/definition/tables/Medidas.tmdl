	/// Verde ≥ 100%, âmbar 80% a 99,9%, coral < 80%.
	measure 'Cor Atingimento' =
			VAR v = [Atingimento %]
			RETURN
			    SWITCH ( TRUE (), ISBLANK ( v ), "#AEB8CF", v >= 1, "#39D98A", v >= 0.8, "#F5B942", "#FF7A68" )
		displayFolder: 09 UX\Cores
		lineageTag: ff416580-4220-4bdd-a4c9-0bc3f95be5d0

	measure 'Cor Score' =
			VAR v = [Score Recomendação]
			RETURN
			    SWITCH ( TRUE (), ISBLANK ( v ), "#AEB8CF", v >= 70, "#39D98A", v >= 40, "#22C7BE", "#AEB8CF" )
		displayFolder: 09 UX\Cores
		lineageTag: b81dd524-a7d1-4dea-bb2e-26d7b9f793a2

	measure 'Insight Meta' =
			VAR vPct = [Gap Meta %]
			VAR vGap = ABS ( [Gap Meta] )
			VAR vGapTxt = IF ( vGap >= 1E6, FORMAT ( vGap / 1E6, "#,0.00" ) & " Mi", FORMAT ( vGap / 1E3, "#,0.0" ) & " mil" )
			RETURN
			    IF (
			        ISBLANK ( vPct ),
			        "Sem meta cadastrada para o período selecionado.",
			        "O faturamento está " & FORMAT ( ABS ( vPct ), "0.0%" )
			            & IF ( vPct >= 0, " acima", " abaixo" )
			            & " da meta acumulada até " & FORMAT ( [Data Última Venda], "dd/mm" )
			            & " (" & IF ( vPct >= 0, "+", "−" ) & "R$ " & vGapTxt & ")."
			    )
		displayFolder: 09 UX\Insights
		lineageTag: 4cfc99c2-a654-4cba-b259-1375f3923dc8

	measure 'Insight Forecast' =
			VAR vFc = [Forecast]
			VAR vFcTxt = IF ( vFc >= 1E6, FORMAT ( vFc / 1E6, "#,0.00" ) & " Mi", FORMAT ( vFc / 1E3, "#,0.0" ) & " mil" )
			VAR vAting = [Atingimento Forecast %]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( vFc ), "Sem vendas no período selecionado.",
			        [Dias Restantes] = 0,
			            "Período encerrado: fechou em R$ " & vFcTxt
			                & IF ( NOT ISBLANK ( vAting ), ", " & FORMAT ( vAting, "0.0%" ) & " da meta.", "." ),
			        "O forecast (" & [Método Forecast Ativo] & ") indica fechamento de R$ " & vFcTxt
			            & ", equivalente a " & FORMAT ( vAting, "0.0%" ) & " da meta do período."
			    )
		displayFolder: 09 UX\Insights
		lineageTag: d8ff04e1-49ee-4957-ac6c-11f82c2c4c95

	measure 'Insight Ritmo' =
			VAR vRest = [Dias Úteis Restantes]
			VAR vNec = [Meta Diária Necessária]
			VAR vReal = [Realizado Diário Médio]
			VAR vRitmo = [Ritmo vs Necessário %]
			RETURN
			    SWITCH (
			        TRUE (),
			        vRest <= 0, "Não há dias úteis restantes no período selecionado.",
			        vNec = 0, "A meta do período já foi atingida; os " & vRest & " dias úteis restantes são ganho adicional.",
			        "Para atingir a meta, será necessário faturar R$ " & FORMAT ( vNec / 1E3, "#,0.0" )
			            & " mil por dia útil nos " & vRest & " dias úteis restantes. O ritmo atual é de R$ "
			            & FORMAT ( vReal / 1E3, "#,0.0" ) & " mil por dia útil (" & FORMAT ( vRitmo, "+0.0%;-0.0%" )
			            & " contra o necessário)."
			    )
		displayFolder: 09 UX\Insights
		lineageTag: 9eacc2fb-60b4-4a26-9a2f-8442d73f0003

	measure 'Insight Vendedor' =
			VAR vTab =
			    FILTER (
			        ADDCOLUMNS ( ALLSELECTED ( dVendedor[descricao] ), "@Gap", [Gap Meta] ),
			        NOT ISBLANK ( [@Gap] )
			    )
			VAR vPior = TOPN ( 1, vTab, [@Gap], ASC )
			VAR vNome = MAXX ( vPior, dVendedor[descricao] )
			VAR vGap = ABS ( MINX ( vPior, [@Gap] ) )
			VAR vAcima = COUNTROWS ( FILTER ( vTab, [@Gap] >= 0 ) ) + 0
			VAR vTotal = COUNTROWS ( vTab )
			RETURN
			    SWITCH (
			        TRUE (),
			        vTotal = 0, "Sem meta por vendedor no período selecionado.",
			        MINX ( vPior, [@Gap] ) >= 0, "Todos os " & vTotal & " vendedores estão acima da meta acumulada.",
			        vNome & " apresenta o maior gap absoluto para a meta (−R$ " & FORMAT ( vGap / 1E3, "#,0.0" )
			            & " mil). " & vAcima & " de " & vTotal & " vendedores estão acima da meta."
			    )
		displayFolder: 09 UX\Insights
		lineageTag: 15c88658-30d1-410b-8086-2f4bca68371a

	measure 'Insight Produto' =
			VAR vTab =
			    FILTER (
			        ADDCOLUMNS ( ALLSELECTED ( dProduto[descricao] ), "@Delta", [YoY Δ] ),
			        NOT ISBLANK ( [@Delta] )
			    )
			VAR vTotal = SUMX ( vTab, [@Delta] )
			VAR vQueda = vTotal < 0
			VAR vPior = TOPN ( 1, vTab, [@Delta], ASC )
			VAR vMelhor = TOPN ( 1, vTab, [@Delta], DESC )
			VAR vNome = IF ( vQueda, MAXX ( vPior, dProduto[descricao] ), MAXX ( vMelhor, dProduto[descricao] ) )
			VAR vDelta = IF ( vQueda, MAXX ( vPior, [@Delta] ), MAXX ( vMelhor, [@Delta] ) )
			VAR vBase =
			    IF (
			        vQueda,
			        SUMX ( FILTER ( vTab, [@Delta] < 0 ), [@Delta] ),
			        SUMX ( FILTER ( vTab, [@Delta] > 0 ), [@Delta] )
			    )
			RETURN
			    IF (
			        ISBLANK ( vDelta ),
			        "Sem base do ano anterior para comparar os produtos.",
			        vNome & " responde por " & FORMAT ( DIVIDE ( vDelta, vBase ), "0.0%" )
			            & IF ( vQueda, " das quedas observadas no período (−R$ ", " dos ganhos observados no período (+R$ " )
			            & FORMAT ( ABS ( vDelta ) / 1E3, "#,0.0" ) & " mil vs ano anterior)."
			    )
		displayFolder: 09 UX\Insights
		lineageTag: ee5ab681-2505-4639-8080-e29e457667d2

	measure 'Insight Clientes' =
			VAR vRisco = [Clientes em Risco]
			VAR vFatRisco = [Faturamento 12M em Risco]
			VAR vShare = DIVIDE ( vFatRisco, [Faturamento 12M] )
			RETURN
			    IF (
			        vRisco > 0,
			        vRisco & " clientes em risco (181 a 365 dias sem comprar) somam R$ "
			            & FORMAT ( vFatRisco / 1E3, "#,0.0" ) & " mil de faturamento nos últimos 12 meses ("
			            & FORMAT ( vShare, "0.0%" ) & " do total). São a prioridade de reativação.",
			        "Nenhum cliente em risco no recorte selecionado."
			    )
		displayFolder: 09 UX\Insights
		lineageTag: f91c6a7c-e674-4ecb-a174-d60f5e9b89fc

	/// Ação comercial sugerida para o cliente selecionado: melhor oferta de cross-sell (score) e melhor oferta de recompra (histórico).
	measure 'Insight NBP' =
			IF (
			    NOT HASONEVALUE ( dCliente[id] ),
			    "Selecione um cliente para ver a próxima melhor oferta.",
			    VAR vCandidatos =
			        FILTER (
			            ADDCOLUMNS (
			                ALL ( dProduto ),
			                "@Score", [Score Recomendação],
			                "@Qtd", [Qtd Comprada Similares],
			                "@Sim", [Similares que Compraram]
			            ),
			            NOT ISBLANK ( [@Score] )
			        )
			    VAR vTop = TOPN ( 1, vCandidatos, [@Score] + DIVIDE ( [@Qtd], 100000 ), DESC )
			    VAR vNome = MAXX ( vTop, dProduto[descricao] & " " & dProduto[tamanho] )
			    VAR vScore = MAXX ( vTop, [@Score] )
			    VAR vSim = MAXX ( vTop, [@Sim] )
			    VAR vRecompra =
			        TOPN (
			            1,
			            FILTER ( ADDCOLUMNS ( ALL ( dProduto ), "@Hist", [Qtd Recompra Sugerida] ), [@Hist] > 0 ),
			            [@Hist], DESC
			        )
			    VAR vNomeRec = MAXX ( vRecompra, dProduto[descricao] & " " & dProduto[tamanho] )
			    VAR vQtdRec = MAXX ( vRecompra, [@Hist] )
			    VAR vCross =
			        SWITCH (
			            TRUE (),
			            [Clientes Similares] = 0, "Cliente sem similares com similaridade ≥ 0,50: não há cross-sell por semelhança.",
			            ISBLANK ( vScore ), "Os clientes similares não compraram nada além do que este cliente já comprou no período.",
			            "Cross-sell: ofereça " & vNome & " (score " & vScore & "), comprado por " & vSim & " de "
			                & [Clientes Similares] & " clientes similares."
			        )
			    VAR vRec =
			        IF (
			            NOT ISBLANK ( vNomeRec ),
			            " Recompra: " & vNomeRec & ", " & vQtdRec & " itens no histórico e nenhum no período."
			        )
			    RETURN
			        vCross & vRec
			            & IF ( NOT ISBLANK ( [Ação Segmento] ), " Postura para o segmento " & [Segmento Cliente] & ": " & [Ação Segmento] )
			)
		displayFolder: 09 UX\Insights
		lineageTag: 28859018-a2c3-4ae7-a00d-39416efaade1

	/// Crescimento do conjunto de produtos selecionados; linha de corte vertical da matriz de performance.
	measure 'YoY Total Produtos %' = CALCULATE ( [YoY %], ALLSELECTED ( dProduto ) )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 05 Produtos
		lineageTag: 541e0e30-187a-4910-b5b5-ed141beaeabd

	/// 1 ÷ número de produtos vendidos; linha de corte horizontal da matriz de performance.
	measure 'Participação Média %' =
			VAR vProdutos = CALCULATETABLE ( ADDCOLUMNS ( VALUES ( dProduto[descricao] ), "@Fat", [Faturamento] ), ALLSELECTED ( dProduto ) )
			RETURN
			    DIVIDE ( 1, COUNTROWS ( FILTER ( vProdutos, NOT ISBLANK ( [@Fat] ) ) ) )
		formatString: 0.0%
		displayFolder: 05 Produtos
		lineageTag: de2fdc13-6984-4ed2-aef8-f2298a20dd24

	measure 'Insight Afinidade' =
			IF (
			    NOT HASONEVALUE ( dProdutoBase[Produto Base] ),
			    "Escolha um produto âncora para ver o que seus clientes também compram.",
			    VAR vBase = SELECTEDVALUE ( dProdutoBase[Produto Base] )
			    VAR vTab =
			        FILTER (
			            ADDCOLUMNS ( ALL ( dProduto[descricao] ), "@Pct", [% Também Compraram], "@Lift", [Lift Afinidade] ),
			            NOT ISBLANK ( [@Pct] )
			        )
			    VAR vTop = TOPN ( 1, vTab, [@Lift], DESC )
			    RETURN
			        "Entre os " & [Clientes Produto Base] & " clientes de " & vBase & ", "
			            & FORMAT ( MAXX ( vTop, [@Pct] ), "0%" ) & " também compraram " & MAXX ( vTop, dProduto[descricao] )
			            & " — " & FORMAT ( MAXX ( vTop, [@Lift] ), "0.00" ) & "x a penetração desse item na base."
			)
		displayFolder: 09 UX\Insights
		lineageTag: a533ee52-e8ef-4534-8195-460d450fa290

