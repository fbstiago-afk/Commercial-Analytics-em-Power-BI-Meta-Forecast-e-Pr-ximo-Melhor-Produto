	/// Subtítulo dinâmico das páginas: período • gerente • categoria • data dos dados.
	measure 'Subtítulo Contexto' =
			[Período Selecionado]
			    & "   •   " & SELECTEDVALUE ( dVendedor[gerente_descricao], "Todos os gerentes" )
			    & "   •   " & SELECTEDVALUE ( dProduto[categoria_descricao], "Todas as categorias" )
			    & "   •   dados até " & FORMAT ( [Data Última Venda], "dd/mm/yyyy" )
		displayFolder: 09 UX\Títulos
		lineageTag: 2f30a20e-e775-4df8-a6a9-342aa6c3a04e

	measure 'Subtítulo Cliente' =
			[Cliente Selecionado]
			    & IF (
