			        "   •   " & SELECTEDVALUE ( dCliente[cidade] ) & "/" & SELECTEDVALUE ( dCliente[uf] )
			            & "   •   segmento " & [Segmento Cliente]
			    )
			    & "   •   " & [Período Selecionado]
