/// Parâmetro desconectado: recorte do ranking de vendedores.
table pRanking
	lineageTag: 70aa052c-41c7-4ddc-b7a0-a13a73f126e4

	column Visão
		lineageTag: 2df654be-0d24-47f4-b031-2dd693baee2d
		isNameInferred
		sourceColumn: [Visão]
		sortByColumn: Ordem

	column Ordem
		isHidden
		lineageTag: cb7a7b09-76b4-4296-9551-654fd9891079
		summarizeBy: none
		isNameInferred
		sourceColumn: [Ordem]

	partition pRanking = calculated
		mode: import
		source =
				DATATABLE (
				    "Visão", STRING,
				    "Ordem", INTEGER,
				    {
				        { "Todos", 1 },
				        { "Acima da meta", 2 },
				        { "Abaixo da meta", 3 },
				        { "Top performers", 4 },
				        { "Em risco", 5 }
				    }
				)

