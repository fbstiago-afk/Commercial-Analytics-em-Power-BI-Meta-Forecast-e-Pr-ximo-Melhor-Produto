				DATATABLE (
				    "Método", STRING,
				    "Ordem", INTEGER,
				    "Como funciona", STRING,
				    {
				        { "Adaptativo", 1, "Combina o ritmo do mês com a sazonalidade do ano anterior; o peso do ritmo cresce conforme o mês avança." },
				        { "Run Rate", 2, "Média diária realizada no mês corrente aplicada aos dias que faltam." },
				        { "Média Móvel 28d", 3, "Média diária das últimas 4 semanas aplicada aos dias que faltam." },
				        { "Sazonal", 4, "Mesmos dias do ano anterior corrigidos pelo crescimento dos últimos 90 dias." },
				        { "Plano de Metas", 5, "Método original do relatório: assume que os dias restantes fecham exatamente na meta." }
				    }
				)

